{
  "name": "battery-storage-system",
  "private": true,
  "version": "1.0.8",
  "description": "Battery Charge Tracking and Maintenance Management System",
  "repository": {
    "type": "git",
    "url": "https://github.com/amdakalar/Battery-Storage-System.git"
  },
  "author": {
    "name": "Ahmed M. Salih",
    "email": ""
  },
  "license": "UNLICENSED",
  "main": "dist-electron/main.js",
  "scripts": {
    "prepare": "node scripts/prepare-build.js",
    "dev": "npm run prepare && npm run electron:build && concurrently -n VITE,ELECTRON -c cyan,green \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron dist-electron/main.js\"",
    "dev:desktop": "npm run dev",
    "dev:web": "next dev",
    "vite:build": "vite build",
    "build:web": "next build --webpack",
    "start:web": "next start",
    "electron:build": "node scripts/build-electron.mjs",
    "build": "npm run prepare && npm run vite:build && npm run electron:build",
    "dist": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64 --config electron-builder.yml",
    "release": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --config electron-builder.yml --publish=never",
    "lint": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@heroicons/react": "^2.2.0",
    "@libsql/client": "^0.17.4",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^16.3.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.26",
    "rcedit": "^5.0.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vercel": "^59.4.0",
    "vite": "^6.2.3",
    "wait-on": "^8.0.5"
  }
}
