# ==============================================================================
# 🚀 Environment Variables for Battery Storage System (Next.js + Turso + R2)
# Add these variables to your Vercel Project Settings -> Environment Variables.
# ==============================================================================

# --- 🗄️ Turso Database (Cloud Distributed SQLite) ---
# Create a free database at https://turso.tech and get the database URL & Token
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# --- ☁️ Cloudflare R2 (Object Storage for Images & Backups) ---
# Create a free R2 bucket at https://dash.cloudflare.com -> R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=battery-storage-assets
R2_PUBLIC_URL=https://your-custom-r2-domain-or-r2-url.com

# --- 🌐 App Configuration ---
NEXT_PUBLIC_APP_NAME="Battery Storage System"
